<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── Header ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙  Axiom Voice Pitch"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LSPosed · WhatsApp · Telegram · Discord · Signal"
            android:textSize="12sp"
            android:textColor="@color/subtitle"
            android:layout_marginBottom="28dp" />

        <!-- ── Enable card ── -->
        <androidx.cardview.widget.CardView
            xmlns:card="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card:cardCornerRadius="12dp"
            card:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Pitch Shift"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switch_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Pitch slider card ── -->
        <androidx.cardview.widget.CardView
            xmlns:card="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card:cardCornerRadius="12dp"
            card:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_semitones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pitch: +0.00 semitones"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● No shift"
                    android:textSize="13sp"
                    android:textColor="@color/subtitle"
                    android:layout_marginBottom="12dp" />

                <SeekBar
                    android:id="@+id/seekbar_pitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-12 st"
                        android:textSize="11sp"
                        android:textColor="@color/subtitle" />
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+12 st"
                        android:textSize="11sp"
                        android:textColor="@color/subtitle" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Preset buttons card ── -->
        <androidx.cardview.widget.CardView
            xmlns:card="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card:cardCornerRadius="12dp"
            card:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presets"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_preset_robot"
                        style="@style/PresetButton" android:text="Robot\n-12" android:layout_weight="1" />
                    <Button android:id="@+id/btn_preset_deep"
                        style="@style/PresetButton" android:text="Deep\n-6" android:layout_weight="1" />
                    <Button android:id="@+id/btn_preset_normal"
                        style="@style/PresetButton" android:text="Normal\n0" android:layout_weight="1" />
                    <Button android:id="@+id/btn_preset_high"
                        style="@style/PresetButton" android:text="High\n+6" android:layout_weight="1" />
                    <Button android:id="@+id/btn_preset_chipmunk"
                        style="@style/PresetButton" android:text="Chip\n+12" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Reset ── -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to 0"
            android:layout_marginBottom="24dp" />

        <!-- ── Info footer ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠  Force-stop the target app after changing settings for hooks to take effect.\n\nScope this module to target apps via LSPosed Manager."
            android:textSize="12sp"
            android:textColor="@color/subtitle"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>
